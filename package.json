{
  "name": "sample-doix-application",
  "version": "1.0.0",
  "dependencies": {
    "protocol-agnostic-router": "^1.0.4",
    "string-normalize-space": "^1.0.1",
    "uniqid": "^5.4.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "scripts": {
    "test": "jest",
    "test-ci": "jest --ci --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "lib/app/**/*.js",
      "lib/workflow/*.js"
    ],
    "coverageReporters": [
      "clover",
      "json",
      "lcov",
      "text",
      "json-summary"
    ],
    "verbose": false,
    "slowTestThreshold": 60,
    "globalSetup": "./__tests__/lib/globalSetup.js",
    "globalTeardown": "./__tests__/lib/globalTeardown.js",
    "testEnvironment": "./__tests__/lib/testEnvironment.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/data",
      "/__tests__/lib"
    ]
  },
  "peerDependencies": {
    "doix": "^1.0.69",
    "doix-db-clickhouse": "^1.0.82",
    "doix-http": "^1.0.18"
  },
  "devDependencies": {
    "command-line-args": "5.2.1",
    "jest": "^29.7.0"
  }
}
